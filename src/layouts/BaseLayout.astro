---
import '../styles/globals.css'
import { t } from '../i18n'

interface Props {
  title: string
}

const { title } = Astro.props
const lang = Astro.currentLocale ?? 'ja'
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | TXT-Crypter-Neo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Space Grotesk', sans-serif; }
    </style>
    <script>
      (function() {
        var base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
        var theme = localStorage.getItem('theme')
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark')
        }
        var detected = localStorage.getItem('lang_detected')
        if (!detected) {
          var navLang = navigator.language || ''
          var path = window.location.pathname
          var p = path.startsWith(base) ? path.slice(base.length) || '/' : path
          if (navLang.startsWith('en') && p === '/') {
            window.location.replace(base + '/en/')
          }
          localStorage.setItem('lang_detected', '1')
        }
      })()
    </script>
  </head>
  <body class="min-h-dvh bg-cream text-black-neo dark:bg-cream-dark dark:text-gray-100 transition-colors">
    <header class="border-b-4 border-black-neo bg-yellow-neo dark:bg-yellow-neo/80">
      <nav class="mx-auto flex max-w-2xl items-center justify-between px-6 py-5">
        <a href={base || '/'} class="text-2xl font-bold tracking-tight hover:underline underline-offset-4 decoration-4">TXT-Crypter-Neo</a>
        <div class="flex items-center gap-2 text-sm font-semibold">
          <button id="theme-toggle" class="border-4 border-black-neo bg-white px-3 py-2 text-base hover:bg-yellow-neo transition-colors" aria-label={t('darkmode.toggle', lang)}>
            <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
          </button>
          <button id="lang-toggle" class="border-4 border-black-neo bg-white px-3 py-2 text-xs font-bold uppercase hover:bg-yellow-neo transition-colors">{t('nav.lang_switch', lang)}</button>
          <a href={lang === 'ja' ? `${base}/` : `${base}/en/`} class="border-4 border-black-neo bg-white px-4 py-2 hover:bg-yellow-neo transition-colors">{t('nav.encrypt', lang)}</a>
          <a href={lang === 'ja' ? `${base}/decrypt` : `${base}/en/decrypt`} class="border-4 border-black-neo bg-white px-4 py-2 hover:bg-yellow-neo transition-colors">{t('nav.decrypt', lang)}</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-2xl px-6 py-12">
      <slot />
    </main>
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', function() {
        var html = document.documentElement
        html.classList.toggle('dark')
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light')
      })
      document.getElementById('lang-toggle')?.addEventListener('click', function() {
        var base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
        var path = window.location.pathname
        var p = path.startsWith(base) ? path.slice(base.length) || '/' : path
        if (p.startsWith('/en/')) {
          window.location.href = base + p.replace(/^\/en/, '') || base + '/'
        } else if (p === '/en') {
          window.location.href = base + '/'
        } else {
          window.location.href = base + '/en' + (p === '/' ? '/' : p)
        }
      })
    </script>
  </body>
</html>
