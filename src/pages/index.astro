---
import BaseLayout from '../layouts/BaseLayout.astro'
import { t } from '../i18n'
import type { Locale } from '../i18n'

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { locale: 'ja' as Locale } },
    { params: { lang: 'en' }, props: { locale: 'en' as Locale } },
  ]
}

const { locale } = Astro.props
---

<BaseLayout title={t('encrypt.title', locale)}>
  <section class="space-y-6">
    <h1 class="text-2xl font-bold">{t('encrypt.title', locale)}</h1>
    <p class="text-gray-500 dark:text-gray-400">{t('footer.description', locale)}</p>
    <div id="encrypt-root" class="space-y-4" data-lang={locale}>
      <p class="text-gray-400">Loading...</p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../components/EncryptForm'
</script>
